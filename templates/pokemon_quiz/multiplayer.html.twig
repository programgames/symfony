{% extends 'base.html.twig' %}

{% block title %}Multijoueur - {{ generationName }} - Pokemon Cry Quiz{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --pokemon-red: #E3350D;
        --pokemon-blue: #0A285F;
        --pokemon-yellow: #FFCB05;
        --pokemon-gold: #B3A125;
        --success-green: #48BB78;
    }

    body {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 100vh;
        color: white;
    }

    .game-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 1.5rem;
        max-width: 1600px;
        margin: 0 auto;
        padding: 1rem;
        min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: fit-content;
        position: sticky;
        top: 1rem;
    }

    .sidebar-section {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 10px;
        padding: 1rem;
    }

    .sidebar-title {
        font-size: 0.85rem;
        text-transform: uppercase;
        color: var(--pokemon-yellow);
        margin-bottom: 0.75rem;
        font-weight: bold;
    }

    /* Session Info */
    .session-code {
        font-family: monospace;
        font-size: 1.5rem;
        font-weight: bold;
        color: var(--pokemon-yellow);
        text-align: center;
        letter-spacing: 2px;
    }

    .copy-link-btn {
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.5rem;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

    .copy-link-btn:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .copy-link-btn.copied {
        background: var(--success-green);
        border-color: var(--success-green);
    }

    /* Players List */
    .player-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        margin-bottom: 0.5rem;
    }

    .player-color {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .player-name {
        flex: 1;
        font-size: 0.9rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .player-name.is-you::after {
        content: ' (vous)';
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
    }

    .player-score {
        font-weight: bold;
        color: var(--pokemon-yellow);
    }

    .host-badge {
        font-size: 0.65rem;
        background: var(--pokemon-red);
        padding: 2px 6px;
        border-radius: 4px;
    }

    /* Stats */
    .stat-row {
        display: flex;
        justify-content: space-between;
        padding: 0.4rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .stat-row:last-child {
        border-bottom: none;
    }

    .stat-label {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.85rem;
    }

    .stat-value {
        font-weight: bold;
    }

    /* Activity Log */
    .activity-item {
        font-size: 0.8rem;
        padding: 0.4rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.8);
    }

    .activity-item .player-name {
        font-weight: bold;
    }

    .activity-item.found { color: var(--success-green); }
    .activity-item.skip { color: var(--pokemon-red); }
    .activity-item.hint { color: #6366f1; }
    .activity-item.join { color: #4ECDC4; }

    /* Timer */
    .timer {
        font-size: 1.5rem;
        font-weight: bold;
        text-align: center;
        font-family: monospace;
    }

    /* Main Content */
    .main-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .quiz-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .back-link {
        color: var(--pokemon-yellow);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .gen-title {
        font-size: 1.25rem;
        font-weight: bold;
    }

    /* Progress */
    .progress-section {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        padding: 1rem;
    }

    .progress-text {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .progress-bar-container {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        height: 16px;
        overflow: hidden;
    }

    .progress-bar-fill {
        background: linear-gradient(90deg, var(--pokemon-yellow), var(--pokemon-gold));
        height: 100%;
        border-radius: 10px;
        transition: width 0.5s ease;
    }

    /* Join Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.9);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-overlay.hidden {
        display: none;
    }

    .modal-content {
        background: linear-gradient(145deg, #2a2a4a, #1a1a3a);
        border: 3px solid var(--pokemon-yellow);
        border-radius: 20px;
        padding: 2rem;
        text-align: center;
        max-width: 400px;
        width: 90%;
    }

    .modal-title {
        font-size: 1.5rem;
        color: var(--pokemon-yellow);
        margin-bottom: 1rem;
    }

    .modal-input {
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.1);
        color: white;
        text-align: center;
        margin-bottom: 1rem;
    }

    .modal-input:focus {
        outline: none;
        border-color: var(--pokemon-yellow);
    }

    .modal-btn {
        background: linear-gradient(145deg, var(--pokemon-yellow), var(--pokemon-gold));
        border: none;
        color: #1a1a2e;
        padding: 0.75rem 2rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 25px;
        cursor: pointer;
    }

    .modal-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Waiting Room */
    .waiting-room {
        text-align: center;
        padding: 3rem;
    }

    .waiting-title {
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .waiting-text {
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 2rem;
    }

    .start-game-btn {
        background: linear-gradient(145deg, var(--success-green), #38a169);
        border: none;
        color: white;
        padding: 1rem 3rem;
        font-size: 1.25rem;
        font-weight: bold;
        border-radius: 50px;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .start-game-btn:hover {
        transform: scale(1.05);
    }

    .start-game-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    /* Game Section */
    .game-section {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        padding: 1.5rem;
        text-align: center;
    }

    .buttons-row {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .play-cry-btn {
        background: linear-gradient(145deg, var(--pokemon-yellow), var(--pokemon-gold));
        border: none;
        color: #1a1a2e;
        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 50px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .play-cry-btn:hover { transform: scale(1.05); }
    .play-cry-btn.playing { animation: pulse 0.5s infinite alternate; }

    @keyframes pulse {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    .hint-btn {
        background: linear-gradient(145deg, #6366f1, #4f46e5);
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: bold;
        border-radius: 50px;
        cursor: pointer;
    }

    .hint-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .skip-btn {
        background: linear-gradient(145deg, #ef4444, #dc2626);
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        font-size: 0.9rem;
        font-weight: bold;
        border-radius: 50px;
        cursor: pointer;
    }

    .hint-display {
        min-height: 40px;
        margin-bottom: 1rem;
    }

    .type-badges {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
    }

    .type-badge {
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    .type-normal { background: #A8A878; color: white; }
    .type-feu { background: #F08030; color: white; }
    .type-eau { background: #6890F0; color: white; }
    .type-electrik { background: #F8D030; color: #1a1a2e; }
    .type-plante { background: #78C850; color: white; }
    .type-glace { background: #98D8D8; color: #1a1a2e; }
    .type-combat { background: #C03028; color: white; }
    .type-poison { background: #A040A0; color: white; }
    .type-sol { background: #E0C068; color: #1a1a2e; }
    .type-vol { background: #A890F0; color: white; }
    .type-psy { background: #F85888; color: white; }
    .type-insecte { background: #A8B820; color: white; }
    .type-roche { background: #B8A038; color: white; }
    .type-spectre { background: #705898; color: white; }
    .type-dragon { background: #7038F8; color: white; }
    .type-fee { background: #EE99AC; color: #1a1a2e; }

    .reveal-answer {
        display: none;
        margin-top: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: rgba(239, 68, 68, 0.2);
        border: 2px solid #ef4444;
        border-radius: 10px;
    }

    .reveal-answer.active { display: inline-block; }
    .reveal-name { font-size: 1.25rem; font-weight: bold; color: #ef4444; }

    .answer-input {
        width: 100%;
        max-width: 350px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        text-align: center;
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .answer-input:focus {
        outline: none;
        border-color: var(--pokemon-yellow);
    }

    .answer-input.correct {
        border-color: var(--success-green);
        background: rgba(72, 187, 120, 0.2);
    }

    /* Volume & Cry Version */
    .controls-row {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .control-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        padding: 0.5rem 1rem;
        border-radius: 25px;
    }

    .volume-slider {
        width: 80px;
        -webkit-appearance: none;
        height: 6px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }

    .volume-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 14px;
        height: 14px;
        background: var(--pokemon-yellow);
        border-radius: 50%;
        cursor: pointer;
    }

    .cry-toggle {
        display: flex;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 2px;
    }

    .cry-toggle-btn {
        padding: 0.3rem 0.75rem;
        border: none;
        background: transparent;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.8rem;
        border-radius: 18px;
        cursor: pointer;
    }

    .cry-toggle-btn.active {
        background: var(--pokemon-yellow);
        color: #1a1a2e;
    }

    /* Pokemon Grid */
    .collection-section {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        padding: 1rem;
    }

    .collection-title {
        font-size: 1rem;
        color: var(--pokemon-yellow);
        margin-bottom: 0.75rem;
    }

    .pokemon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(45px, 1fr));
        gap: 3px;
    }

    .pokemon-slot {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.3);
        border-radius: 5px;
        position: relative;
    }

    .pokemon-slot .pokeball-icon {
        width: 55%;
        height: 55%;
        opacity: 0.2;
    }

    .pokemon-slot.found {
        background: rgba(72, 187, 120, 0.2);
        border: 2px solid var(--success-green);
    }

    .pokemon-slot.found .pokeball-icon { display: none; }

    .pokemon-slot .pokemon-sprite {
        display: none;
        width: 80%;
        height: 80%;
        image-rendering: pixelated;
        object-fit: contain;
    }

    .pokemon-slot.found .pokemon-sprite { display: block; }

    .pokemon-slot .finder-dot {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: none;
    }

    .pokemon-slot.found .finder-dot { display: block; }

    /* Victory Modal */
    .victory-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.9);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .victory-overlay.active { display: flex; }

    .victory-modal {
        background: linear-gradient(145deg, #2a2a4a, #1a1a3a);
        border: 3px solid var(--pokemon-yellow);
        border-radius: 20px;
        padding: 2rem;
        text-align: center;
        max-width: 500px;
        animation: victoryBounce 0.5s ease;
    }

    @keyframes victoryBounce {
        0% { transform: scale(0.5); opacity: 0; }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); opacity: 1; }
    }

    .victory-title {
        font-size: 2rem;
        color: var(--pokemon-yellow);
        margin-bottom: 1rem;
    }

    .victory-time {
        font-size: 2.5rem;
        font-weight: bold;
        font-family: monospace;
        margin-bottom: 1rem;
    }

    .victory-stats {
        margin-bottom: 1.5rem;
    }

    .victory-btn {
        background: linear-gradient(145deg, var(--pokemon-yellow), var(--pokemon-gold));
        border: none;
        color: #1a1a2e;
        padding: 0.75rem 2rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 25px;
        cursor: pointer;
        text-decoration: none;
    }

    @media (max-width: 900px) {
        .game-layout {
            grid-template-columns: 1fr;
        }
        .sidebar {
            position: static;
            flex-direction: row;
            flex-wrap: wrap;
        }
        .sidebar-section {
            flex: 1;
            min-width: 200px;
        }
    }
</style>
{% endblock %}

{% block body %}
<!-- Join Modal (if no player) -->
<div class="modal-overlay {% if player %}hidden{% endif %}" id="join-modal">
    <div class="modal-content">
        <h2 class="modal-title">Rejoindre la partie</h2>
        <p style="margin-bottom: 1rem; color: rgba(255,255,255,0.7);">{{ generationName }}</p>
        <input type="text" class="modal-input" id="player-name-input" placeholder="Ton pseudo..." maxlength="50" autocomplete="off">
        <button class="modal-btn" id="join-btn">Rejoindre</button>
    </div>
</div>

<!-- Victory Modal -->
<div class="victory-overlay" id="victory-overlay">
    <div class="victory-modal">
        <h2 class="victory-title">Victoire !</h2>
        <div class="victory-time" id="victory-time">00:00</div>
        <div class="victory-stats" id="victory-stats"></div>
        <a href="{{ path('pokemon_quiz_index') }}" class="victory-btn">Retour au menu</a>
    </div>
</div>

<div class="game-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-section">
            <div class="sidebar-title">Code de la partie</div>
            <div class="session-code">{{ session.id }}</div>
            <button class="copy-link-btn" id="copy-link-btn">Copier le lien</button>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-title">Chrono</div>
            <div class="timer" id="timer">00:00</div>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-title">Joueurs (<span id="player-count">{{ session.players|length }}</span>/8)</div>
            <div id="players-list">
                {% for p in session.players %}
                <div class="player-item">
                    <span class="player-color" style="background: {{ p.color }}"></span>
                    <span class="player-name {% if player and p.id == player.id %}is-you{% endif %}">
                        {{ p.name }}
                    </span>
                    {% if p.isHost %}<span class="host-badge">HOTE</span>{% endif %}
                    <span class="player-score">{{ p.score }}</span>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-title">Statistiques</div>
            <div class="stat-row">
                <span class="stat-label">Indices utilises</span>
                <span class="stat-value" id="total-hints">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">Pokemon passes</span>
                <span class="stat-value" id="total-skips">0</span>
            </div>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-title">Activite recente</div>
            <div id="activity-log"></div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <header class="quiz-header">
            <a href="{{ path('pokemon_quiz_index') }}" class="back-link">&larr; Quitter</a>
            <h1 class="gen-title">{{ generationName }} - Multijoueur</h1>
            <div></div>
        </header>

        <section class="progress-section">
            <div class="progress-text">
                <span>Progression</span>
                <span id="progress-count">0/{{ totalCount }}</span>
            </div>
            <div class="progress-bar-container">
                <div class="progress-bar-fill" id="progress-bar" style="width: 0%"></div>
            </div>
        </section>

        <!-- Waiting Room (before game starts) -->
        <section class="game-section waiting-room" id="waiting-room">
            <h2 class="waiting-title">En attente des joueurs...</h2>
            <p class="waiting-text">Partagez le lien pour inviter vos amis</p>
            {% if player and player.isHost %}
            <button class="start-game-btn" id="start-game-btn">Lancer la partie</button>
            {% else %}
            <p style="color: rgba(255,255,255,0.5);">L'hote va bientot lancer la partie</p>
            {% endif %}
        </section>

        <!-- Game Section (when started) -->
        <section class="game-section" id="game-section" style="display: none;">
            <div class="controls-row">
                <div class="control-group">
                    <span id="volume-icon">&#128266;</span>
                    <input type="range" class="volume-slider" id="volume-slider" min="0" max="100" value="50">
                </div>
                <div class="control-group">
                    <div class="cry-toggle">
                        <button class="cry-toggle-btn" id="cry-legacy-btn" data-version="legacy">Ancien</button>
                        <button class="cry-toggle-btn active" id="cry-latest-btn" data-version="latest">Nouveau</button>
                    </div>
                </div>
            </div>

            <div class="buttons-row">
                <button class="play-cry-btn" id="play-cry-btn">
                    <span>&#128266;</span> Ecouter
                </button>
                <button class="hint-btn" id="hint-btn">Indice</button>
                <button class="skip-btn" id="skip-btn">Passer</button>
            </div>

            <div class="hint-display" id="hint-display">
                <div class="type-badges" id="type-badges"></div>
                <div class="reveal-answer" id="reveal-answer">
                    <div style="font-size: 0.8rem; color: rgba(255,255,255,0.7);">C'etait...</div>
                    <div class="reveal-name" id="reveal-name"></div>
                </div>
            </div>

            <input type="text" class="answer-input" id="answer-input" placeholder="Nom du Pokemon..." autocomplete="off">
        </section>

        <!-- Collection Grid -->
        <section class="collection-section">
            <h2 class="collection-title">Collection</h2>
            <div class="pokemon-grid" id="pokemon-grid">
                {% for id, pokemon in pokemonData %}
                <div class="pokemon-slot" data-id="{{ id }}">
                    <svg class="pokeball-icon" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="48" fill="#333" stroke="#555" stroke-width="3"/>
                        <path d="M2 50 H98" stroke="#555" stroke-width="3"/>
                        <circle cx="50" cy="50" r="12" fill="#222" stroke="#555" stroke-width="3"/>
                    </svg>
                    <img class="pokemon-sprite" data-src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/{{ id }}.png" alt="">
                    <span class="finder-dot"></span>
                </div>
                {% endfor %}
            </div>
        </section>
    </main>
</div>

<audio id="pokemon-audio" preload="auto"></audio>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const sessionId = '{{ session.id }}';
    const totalCount = {{ totalCount }};
    const pokemonData = {{ pokemonData|json_encode|raw }};
    const baseUrl = window.location.origin;

    let playerId = '{{ player ? player.id : '' }}';
    let playerColor = '{{ player ? player.color : '' }}';
    let isHost = {{ player and player.isHost ? 'true' : 'false' }};
    let isStarted = {{ session.isStarted ? 'true' : 'false' }};
    let isFinished = {{ session.isFinished ? 'true' : 'false' }};
    let currentPokemonId = {{ session.currentPokemonId ?? 'null' }};
    let cryVersion = 'latest';
    let isPlaying = false;
    let hintUsedForCurrent = false;
    let lastUpdatedAt = null;
    let pollInterval = null;

    // DOM Elements
    const joinModal = document.getElementById('join-modal');
    const playerNameInput = document.getElementById('player-name-input');
    const joinBtn = document.getElementById('join-btn');
    const copyLinkBtn = document.getElementById('copy-link-btn');
    const waitingRoom = document.getElementById('waiting-room');
    const gameSection = document.getElementById('game-section');
    const startGameBtn = document.getElementById('start-game-btn');
    const playersList = document.getElementById('players-list');
    const playerCountEl = document.getElementById('player-count');
    const activityLog = document.getElementById('activity-log');
    const timerEl = document.getElementById('timer');
    const totalHintsEl = document.getElementById('total-hints');
    const totalSkipsEl = document.getElementById('total-skips');
    const progressBar = document.getElementById('progress-bar');
    const progressCount = document.getElementById('progress-count');
    const pokemonGrid = document.getElementById('pokemon-grid');
    const playCryBtn = document.getElementById('play-cry-btn');
    const hintBtn = document.getElementById('hint-btn');
    const skipBtn = document.getElementById('skip-btn');
    const typeBadges = document.getElementById('type-badges');
    const revealAnswer = document.getElementById('reveal-answer');
    const revealName = document.getElementById('reveal-name');
    const answerInput = document.getElementById('answer-input');
    const audio = document.getElementById('pokemon-audio');
    const volumeSlider = document.getElementById('volume-slider');
    const volumeIcon = document.getElementById('volume-icon');
    const cryLegacyBtn = document.getElementById('cry-legacy-btn');
    const cryLatestBtn = document.getElementById('cry-latest-btn');
    const victoryOverlay = document.getElementById('victory-overlay');

    // Init
    audio.volume = 0.5;
    if (playerId) startPolling();

    // Copy link
    copyLinkBtn.addEventListener('click', function() {
        const link = baseUrl + '/pokemon-quiz/multiplayer/play/' + sessionId;
        navigator.clipboard.writeText(link).then(() => {
            this.textContent = 'Copie !';
            this.classList.add('copied');
            setTimeout(() => {
                this.textContent = 'Copier le lien';
                this.classList.remove('copied');
            }, 2000);
        });
    });

    // Auto-copy on load for host
    if (isHost && !isStarted) {
        const link = baseUrl + '/pokemon-quiz/multiplayer/play/' + sessionId;
        navigator.clipboard.writeText(link).catch(() => {});
    }

    // Join game
    joinBtn.addEventListener('click', joinGame);
    playerNameInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') joinGame();
    });

    function joinGame() {
        const name = playerNameInput.value.trim();
        if (!name) return;

        joinBtn.disabled = true;
        fetch('/pokemon-quiz/multiplayer/join/' + sessionId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ playerName: name })
        })
        .then(r => r.json())
        .then(data => {
            if (data.error) {
                alert(data.error);
                joinBtn.disabled = false;
                return;
            }
            playerId = data.playerId;
            playerColor = data.playerColor;
            joinModal.classList.add('hidden');
            startPolling();
        })
        .catch(() => {
            alert('Erreur de connexion');
            joinBtn.disabled = false;
        });
    }

    // Start game (host only)
    if (startGameBtn) {
        startGameBtn.addEventListener('click', function() {
            this.disabled = true;
            fetch('/pokemon-quiz/multiplayer/start/' + sessionId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ playerId: playerId })
            })
            .then(r => r.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                    this.disabled = false;
                }
            });
        });
    }

    // Polling for state updates
    function startPolling() {
        pollState();
        pollInterval = setInterval(pollState, 1000);
    }

    function pollState() {
        fetch('/pokemon-quiz/multiplayer/state/' + sessionId + '?playerId=' + playerId)
        .then(r => r.json())
        .then(state => {
            if (state.error) return;

            // Check for updates
            if (state.updatedAt !== lastUpdatedAt) {
                lastUpdatedAt = state.updatedAt;
                updateUI(state);
            }

            // Update timer
            if (state.elapsedTime !== null) {
                timerEl.textContent = formatTime(state.elapsedTime);
            }
        });
    }

    function updateUI(state) {
        // Game started
        if (state.isStarted && !isStarted) {
            isStarted = true;
            waitingRoom.style.display = 'none';
            gameSection.style.display = 'block';
        }

        // Current Pokemon changed
        if (state.currentPokemonId !== currentPokemonId) {
            currentPokemonId = state.currentPokemonId;
            hintUsedForCurrent = false;
            hintBtn.disabled = false;
            typeBadges.innerHTML = '';
            revealAnswer.classList.remove('active');
            if (currentPokemonId) {
                loadCry(currentPokemonId);
            }
        }

        // Update found pokemon
        for (const [id, info] of Object.entries(state.foundPokemon)) {
            markPokemonFound(parseInt(id), info.pokemonName, info.playerId);
        }

        // Update progress
        const foundCount = Object.keys(state.foundPokemon).length;
        progressCount.textContent = foundCount + '/' + totalCount;
        progressBar.style.width = (foundCount / totalCount * 100) + '%';

        // Update players
        updatePlayersList(state.players);

        // Update stats
        totalHintsEl.textContent = state.totalHintsUsed;
        totalSkipsEl.textContent = state.totalSkipsUsed;

        // Update activity
        updateActivityLog(state.activityLog);

        // Victory
        if (state.isFinished && !isFinished) {
            isFinished = true;
            showVictory(state);
        }
    }

    function updatePlayersList(players) {
        playerCountEl.textContent = players.length;
        playersList.innerHTML = players.map(p => `
            <div class="player-item">
                <span class="player-color" style="background: ${p.color}"></span>
                <span class="player-name ${p.id === playerId ? 'is-you' : ''}">${escapeHtml(p.name)}</span>
                ${p.isHost ? '<span class="host-badge">HOTE</span>' : ''}
                <span class="player-score">${p.score}</span>
            </div>
        `).join('');
    }

    function updateActivityLog(activities) {
        activityLog.innerHTML = activities.map(a => {
            let text = '';
            if (a.type === 'found') text = `<b>${escapeHtml(a.playerName)}</b> a trouve ${a.pokemonName}`;
            else if (a.type === 'skip') text = `<b>${escapeHtml(a.playerName)}</b> a passe`;
            else if (a.type === 'hint') text = `<b>${escapeHtml(a.playerName)}</b> a utilise un indice`;
            else if (a.type === 'join') text = `<b>${escapeHtml(a.playerName)}</b> a rejoint`;
            return `<div class="activity-item ${a.type}">${text}</div>`;
        }).join('');
    }

    function markPokemonFound(pokemonId, pokemonName, foundByPlayerId) {
        const slot = pokemonGrid.querySelector(`.pokemon-slot[data-id="${pokemonId}"]`);
        if (slot && !slot.classList.contains('found')) {
            slot.classList.add('found');
            slot.title = pokemonName;

            const sprite = slot.querySelector('.pokemon-sprite');
            if (sprite && sprite.dataset.src) {
                sprite.src = sprite.dataset.src;
            }

            // Show finder color
            const dot = slot.querySelector('.finder-dot');
            const player = getPlayerById(foundByPlayerId);
            if (dot && player) {
                dot.style.background = player.color || '#fff';
            }
        }
    }

    function getPlayerById(id) {
        // Get from current players list in DOM
        return { color: playerColor }; // Simplified, will be updated on next poll
    }

    function showVictory(state) {
        document.getElementById('victory-time').textContent = formatTime(state.elapsedTime);
        document.getElementById('victory-stats').innerHTML = `
            <p>Pokemon trouves: ${Object.keys(state.foundPokemon).length}/${totalCount}</p>
            <p>Indices utilises: ${state.totalHintsUsed}</p>
            <p>Pokemon passes: ${state.totalSkipsUsed}</p>
        `;
        victoryOverlay.classList.add('active');
    }

    // Audio controls
    function loadCry(pokemonId) {
        isPlaying = false;
        playCryBtn.classList.remove('playing');
        audio.pause();
        audio.src = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/${cryVersion}/${pokemonId}.ogg`;
        audio.load();
    }

    playCryBtn.addEventListener('click', () => {
        if (isPlaying || !currentPokemonId) return;
        isPlaying = true;
        playCryBtn.classList.add('playing');
        audio.currentTime = 0;
        audio.play().catch(() => {
            isPlaying = false;
            playCryBtn.classList.remove('playing');
        });
    });

    audio.addEventListener('ended', () => {
        isPlaying = false;
        playCryBtn.classList.remove('playing');
    });

    volumeSlider.addEventListener('input', function() {
        audio.volume = this.value / 100;
        volumeIcon.innerHTML = this.value == 0 ? '&#128263;' : this.value < 50 ? '&#128265;' : '&#128266;';
    });

    cryLegacyBtn.addEventListener('click', () => setCryVersion('legacy'));
    cryLatestBtn.addEventListener('click', () => setCryVersion('latest'));

    function setCryVersion(version) {
        cryVersion = version;
        cryLegacyBtn.classList.toggle('active', version === 'legacy');
        cryLatestBtn.classList.toggle('active', version === 'latest');
        if (currentPokemonId) loadCry(currentPokemonId);
    }

    // Hint
    hintBtn.addEventListener('click', () => {
        if (hintUsedForCurrent || !currentPokemonId) return;
        hintUsedForCurrent = true;
        hintBtn.disabled = true;

        fetch('/pokemon-quiz/multiplayer/hint/' + sessionId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ playerId: playerId })
        })
        .then(r => r.json())
        .then(data => {
            if (data.types) {
                typeBadges.innerHTML = data.types.map(type => {
                    const cls = 'type-' + type.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
                    return `<span class="type-badge ${cls}">${type}</span>`;
                }).join('');
            }
        });
    });

    // Skip
    skipBtn.addEventListener('click', () => {
        if (!currentPokemonId) return;

        fetch('/pokemon-quiz/multiplayer/skip/' + sessionId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ playerId: playerId })
        })
        .then(r => r.json())
        .then(data => {
            if (data.skippedPokemonName) {
                revealName.textContent = data.skippedPokemonName;
                revealAnswer.classList.add('active');
                setTimeout(() => {
                    revealAnswer.classList.remove('active');
                }, 2000);
            }
        });
    });

    // Answer input
    answerInput.addEventListener('input', function() {
        if (!currentPokemonId || !this.value.trim()) return;

        fetch('/pokemon-quiz/multiplayer/answer/' + sessionId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                playerId: playerId,
                answer: this.value
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.correct) {
                answerInput.classList.add('correct');
                setTimeout(() => {
                    answerInput.value = '';
                    answerInput.classList.remove('correct');
                }, 300);
            }
        });
    });

    // Helpers
    function formatTime(seconds) {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
});
</script>
{% endblock %}
