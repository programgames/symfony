{% extends 'base.html.twig' %}

{% block title %}Pokemon Quiz - Devine le cri !{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --pokemon-red: #E3350D;
        --pokemon-blue: #0A285F;
        --pokemon-yellow: #FFCB05;
        --pokemon-gold: #B3A125;
    }

    body {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 100vh;
        color: white;
    }

    .quiz-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
    }

    .quiz-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .quiz-title {
        font-size: 3rem;
        font-weight: bold;
        text-shadow: 3px 3px 0 var(--pokemon-blue),
                     -1px -1px 0 var(--pokemon-yellow);
        margin-bottom: 0.5rem;
    }

    .quiz-subtitle {
        color: var(--pokemon-yellow);
        font-size: 1.25rem;
    }

    .generation-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .generation-card {
        background: linear-gradient(145deg, #2a2a4a, #1a1a3a);
        border: 2px solid transparent;
        border-radius: 15px;
        padding: 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        color: white;
    }

    .generation-card:hover:not(.disabled) {
        border-color: var(--pokemon-yellow);
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(255, 203, 5, 0.2);
    }

    .generation-card.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .generation-card .gen-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: var(--pokemon-yellow);
    }

    .generation-card .gen-name {
        font-size: 1rem;
        color: #aaa;
        margin-top: 0.5rem;
    }

    .generation-card .gen-count {
        font-size: 0.85rem;
        color: #888;
        margin-top: 0.25rem;
    }

    .generation-card .coming-soon {
        font-size: 0.75rem;
        color: var(--pokemon-red);
        margin-top: 0.5rem;
        font-style: italic;
    }

    .pokeball-icon {
        width: 50px;
        height: 50px;
        margin-bottom: 1rem;
        opacity: 0.8;
    }

    /* Mode buttons */
    .mode-buttons {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .mode-btn {
        padding: 0.75rem 2rem;
        border: 2px solid transparent;
        border-radius: 50px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .mode-btn.solo {
        background: linear-gradient(145deg, var(--pokemon-yellow), var(--pokemon-gold));
        color: #1a1a2e;
    }

    .mode-btn.multi {
        background: linear-gradient(145deg, #6366f1, #4f46e5);
        color: white;
    }

    .mode-btn:hover {
        transform: scale(1.05);
    }

    .mode-btn.active {
        border-color: white;
    }

    /* Multiplayer create modal */
    .mp-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.9);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .mp-modal-overlay.active {
        display: flex;
    }

    .mp-modal {
        background: linear-gradient(145deg, #2a2a4a, #1a1a3a);
        border: 3px solid #6366f1;
        border-radius: 20px;
        padding: 2rem;
        text-align: center;
        max-width: 400px;
        width: 90%;
    }

    .mp-modal-title {
        font-size: 1.5rem;
        color: #6366f1;
        margin-bottom: 1rem;
    }

    .mp-modal-input {
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.1);
        color: white;
        text-align: center;
        margin-bottom: 1rem;
    }

    .mp-modal-input:focus {
        outline: none;
        border-color: #6366f1;
    }

    .mp-modal-btn {
        background: linear-gradient(145deg, #6366f1, #4f46e5);
        border: none;
        color: white;
        padding: 0.75rem 2rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 25px;
        cursor: pointer;
        margin: 0.25rem;
    }

    .mp-modal-btn.cancel {
        background: rgba(255, 255, 255, 0.1);
    }

    .mp-modal-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .selected-gen {
        color: var(--pokemon-yellow);
        margin-bottom: 1rem;
    }

    /* Mode indicator */
    .mode-indicator {
        text-align: center;
        margin-bottom: 1rem;
        padding: 0.5rem 1rem;
        border-radius: 10px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .mode-indicator.solo {
        background: rgba(255, 203, 5, 0.1);
        color: var(--pokemon-yellow);
    }

    .mode-indicator.multi {
        background: rgba(99, 102, 241, 0.2);
        color: #a5b4fc;
    }

    /* Cards in multiplayer mode */
    .generation-grid.multi-mode .generation-card:not(.disabled) {
        border: 2px solid rgba(99, 102, 241, 0.5);
    }

    .generation-grid.multi-mode .generation-card:not(.disabled):hover {
        border-color: #6366f1;
        box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
    }

    .generation-grid.multi-mode .generation-card:not(.disabled)::after {
        content: 'Creer une partie';
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.7rem;
        color: #a5b4fc;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .generation-grid.multi-mode .generation-card:not(.disabled):hover::after {
        opacity: 1;
    }

    .generation-card {
        position: relative;
    }
</style>
{% endblock %}

{% block body %}
<!-- Multiplayer Modal -->
<div class="mp-modal-overlay" id="mp-modal">
    <div class="mp-modal">
        <h2 class="mp-modal-title">Creer une partie</h2>
        <div class="selected-gen" id="selected-gen-text">Generation I</div>
        <input type="text" class="mp-modal-input" id="host-name-input" placeholder="Ton pseudo..." maxlength="50" autocomplete="off">
        <input type="hidden" id="selected-gen" value="1">
        <div>
            <button class="mp-modal-btn cancel" id="mp-cancel-btn">Annuler</button>
            <button class="mp-modal-btn" id="mp-create-btn">Creer</button>
        </div>
    </div>
</div>

<div class="quiz-container">
    <header class="quiz-header">
        <h1 class="quiz-title">Pokemon Cry Quiz</h1>
        <p class="quiz-subtitle">Devine le Pokemon a partir de son cri !</p>
    </header>

    <div class="mode-buttons">
        <button class="mode-btn solo active" id="mode-solo">Solo</button>
        <button class="mode-btn multi" id="mode-multi">Multijoueur</button>
    </div>

    <div class="mode-indicator solo" id="mode-indicator">
        Mode Solo - Clique sur une generation pour jouer seul
    </div>

    <h2 class="text-center mb-4">Choisis une generation</h2>

    <div class="generation-grid" id="generation-grid">
        {% for genId, gen in generations %}
            {% if gen.available %}
                <a href="{{ path('pokemon_quiz_play', {generation: genId}) }}" class="generation-card" data-gen="{{ genId }}" data-gen-name="{{ gen.name }}">
                    <svg class="pokeball-icon" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="4"/>
                        <path d="M2 50 H98" stroke="currentColor" stroke-width="4"/>
                        <circle cx="50" cy="50" r="15" fill="none" stroke="currentColor" stroke-width="4"/>
                        <circle cx="50" cy="50" r="8" fill="currentColor"/>
                    </svg>
                    <div class="gen-number">{{ genId }}</div>
                    <div class="gen-name">{{ gen.name }}</div>
                    <div class="gen-count">{{ gen.range[1] - gen.range[0] + 1 }} Pokemon</div>
                </a>
            {% else %}
                <div class="generation-card disabled">
                    <svg class="pokeball-icon" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="4"/>
                        <path d="M2 50 H98" stroke="currentColor" stroke-width="4"/>
                        <circle cx="50" cy="50" r="15" fill="none" stroke="currentColor" stroke-width="4"/>
                        <circle cx="50" cy="50" r="8" fill="currentColor"/>
                    </svg>
                    <div class="gen-number">{{ genId }}</div>
                    <div class="gen-name">{{ gen.name }}</div>
                    <div class="gen-count">{{ gen.range[1] - gen.range[0] + 1 }} Pokemon</div>
                    <div class="coming-soon">Bientot disponible</div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modeSolo = document.getElementById('mode-solo');
    const modeMulti = document.getElementById('mode-multi');
    const modeIndicator = document.getElementById('mode-indicator');
    const generationGrid = document.getElementById('generation-grid');
    const mpModal = document.getElementById('mp-modal');
    const mpCancelBtn = document.getElementById('mp-cancel-btn');
    const mpCreateBtn = document.getElementById('mp-create-btn');
    const hostNameInput = document.getElementById('host-name-input');
    const selectedGenInput = document.getElementById('selected-gen');
    const selectedGenText = document.getElementById('selected-gen-text');
    const genCards = document.querySelectorAll('.generation-card:not(.disabled)');

    let isMultiplayerMode = false;

    modeSolo.addEventListener('click', function() {
        isMultiplayerMode = false;
        modeSolo.classList.add('active');
        modeMulti.classList.remove('active');
        generationGrid.classList.remove('multi-mode');
        modeIndicator.className = 'mode-indicator solo';
        modeIndicator.textContent = 'Mode Solo - Clique sur une generation pour jouer seul';
    });

    modeMulti.addEventListener('click', function() {
        isMultiplayerMode = true;
        modeMulti.classList.add('active');
        modeSolo.classList.remove('active');
        generationGrid.classList.add('multi-mode');
        modeIndicator.className = 'mode-indicator multi';
        modeIndicator.textContent = 'Mode Multijoueur - Clique sur une generation pour creer une partie';
    });

    genCards.forEach(card => {
        card.addEventListener('click', function(e) {
            if (isMultiplayerMode) {
                e.preventDefault();
                const gen = this.dataset.gen;
                const genName = this.dataset.genName;
                selectedGenInput.value = gen;
                selectedGenText.textContent = genName;
                mpModal.classList.add('active');
                hostNameInput.focus();
            }
        });
    });

    mpCancelBtn.addEventListener('click', function() {
        mpModal.classList.remove('active');
    });

    mpCreateBtn.addEventListener('click', createGame);
    hostNameInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') createGame();
    });

    function createGame() {
        const name = hostNameInput.value.trim();
        const gen = selectedGenInput.value;

        if (!name) {
            hostNameInput.focus();
            return;
        }

        mpCreateBtn.disabled = true;

        fetch('/pokemon-quiz/multiplayer/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                playerName: name,
                generation: parseInt(gen)
            })
        })
        .then(r => r.json())
        .then(data => {
            if (data.error) {
                alert(data.error);
                mpCreateBtn.disabled = false;
                return;
            }
            // Redirect to game with player ID
            window.location.href = '/pokemon-quiz/multiplayer/play/' + data.sessionId + '?player=' + data.playerId;
        })
        .catch(() => {
            alert('Erreur de connexion');
            mpCreateBtn.disabled = false;
        });
    }
});
</script>
{% endblock %}
