{% extends 'hub/_layout.html.twig' %}

{% block hub_title %}Accueil{% endblock %}

{% block hub_styles %}
    .hero { text-align: center; padding: 2.5rem 0 3rem; }

    .logo {
        font-family: 'Orbitron', sans-serif;
        font-size: clamp(2.4rem, 9vw, 4.5rem);
        font-weight: 900;
        color: #fff;
        letter-spacing: 0.25em;
        text-shadow:
            0 0 10px rgba(0, 255, 255, 0.8),
            0 0 20px rgba(0, 255, 255, 0.6),
            0 0 40px rgba(0, 255, 255, 0.4),
            0 0 80px rgba(0, 255, 255, 0.2);
        animation: pulse-glow 2s ease-in-out infinite alternate;
    }

    @keyframes pulse-glow {
        to {
            text-shadow:
                0 0 15px rgba(0, 255, 255, 1),
                0 0 30px rgba(0, 255, 255, 0.8),
                0 0 60px rgba(0, 255, 255, 0.6),
                0 0 100px rgba(0, 255, 255, 0.4);
        }
    }

    .tagline {
        color: var(--muted);
        letter-spacing: 0.35em;
        text-transform: uppercase;
        margin-top: 0.8rem;
        font-size: 1.05rem;
    }

    .quick {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
        margin-top: 2rem;
    }

    .quick a {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.45rem 1.1rem;
        transition: border-color 0.2s, background 0.2s, transform 0.2s;
    }

    .quick a:hover { border-color: var(--cyan); background: var(--surface-hover); transform: translateY(-2px); }

    .hub-section { margin-top: 3rem; scroll-margin-top: 4.5rem; }

    .section-head {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        margin-bottom: 1.2rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.6rem;
    }

    .section-head h2 {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.35rem;
        letter-spacing: 0.08em;
        color: var(--section-color, var(--cyan));
    }

    .section-head p { color: var(--faint); font-size: 1rem; }

    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.1rem;
    }

    .hub-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.4rem;
        color: var(--text);
        text-decoration: none;
        backdrop-filter: blur(10px);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), background 0.3s, border-color 0.3s, box-shadow 0.3s;
    }

    .hub-card:hover {
        transform: translateY(-6px);
        background: var(--surface-hover);
        border-color: var(--card-color);
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35), 0 0 26px var(--card-glow);
    }

    .hub-card .icon {
        width: 3rem;
        height: 3rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        background: color-mix(in srgb, var(--card-color) 16%, transparent);
        border: 1px solid color-mix(in srgb, var(--card-color) 45%, transparent);
    }

    .hub-card h3 {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.05rem;
        color: var(--card-color);
        margin-top: 0.3rem;
    }

    .hub-card p { color: var(--muted); font-size: 1.02rem; line-height: 1.45; flex: 1; }

    .tag {
        align-self: flex-start;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.05rem 0.6rem;
    }

    .hub-card.featured { grid-column: span 2; }

    @media (max-width: 600px) {
        .hub-card.featured { grid-column: auto; }
        .section-head { flex-direction: column; gap: 0.1rem; }
    }

    .c-yellow { --card-color: var(--yellow); --card-glow: rgba(255, 204, 0, 0.3); }
    .c-green  { --card-color: var(--green);  --card-glow: rgba(68, 255, 136, 0.3); }
    .c-purple { --card-color: var(--purple); --card-glow: rgba(179, 136, 255, 0.3); }
    .c-blurple { --card-color: var(--blurple); --card-glow: rgba(114, 137, 255, 0.3); }
    .c-pink   { --card-color: var(--pink);   --card-glow: rgba(255, 95, 162, 0.3); }
    .c-orange { --card-color: var(--orange); --card-glow: rgba(255, 159, 67, 0.3); }
    .c-cyan   { --card-color: var(--cyan);   --card-glow: var(--cyan-glow); }
{% endblock %}

{% block hub_content %}
<header class="hero">
    <h1 class="logo">GameHub</h1>
    <p class="tagline">Jeux · Serveurs · Guides</p>
    <div class="quick">
        <a href="{{ path('pokemon_quiz_index') }}">🎵 Quiz Pokémon</a>
        <a href="{{ path('servers') }}">⛏️ Serveurs Minecraft</a>
        <a href="https://romm.multimod.ovh" target="_blank" rel="noopener">🕹️ RomM ↗</a>
        <a href="{{ path('app_guide_bot_jeux') }}">🎲 Bot de jeux</a>
        <a href="{{ path('app_guide_bot_musique') }}">🎧 Bot musique</a>
    </div>
</header>

<section class="hub-section" id="jeux" style="--section-color: var(--yellow)">
    <div class="section-head">
        <h2>🎮 Jeux &amp; guides</h2>
        <p>À jouer directement dans le navigateur</p>
    </div>
    <div class="card-grid">
        <a href="{{ path('pokemon_quiz_index') }}" class="hub-card c-yellow featured">
            <span class="icon">🎵</span>
            <h3>Quiz Pokémon</h3>
            <p>Reconnais les Pokémon à leur cri. Seul ou à plusieurs : crée une partie et partage le lien à tes amis.</p>
            <span class="tag">Solo · Multijoueur</span>
        </a>
        <a href="{{ path('app_lol_augments') }}" class="hub-card c-orange">
            <span class="icon">⚔️</span>
            <h3>Optimisations LoL</h3>
            <p>Toutes les optimisations (augments) de l'ARAM du chaos en français, y compris celles du PBE.</p>
            <span class="tag">Guide</span>
        </a>
    </div>
</section>

<section class="hub-section" id="minecraft" style="--section-color: var(--green)">
    <div class="section-head">
        <h2>⛏️ Minecraft</h2>
        <p>Nos serveurs moddés et de quoi bien y jouer</p>
    </div>
    <div class="card-grid">
        <a href="{{ path('servers') }}" class="hub-card c-green featured">
            <span class="icon">🟩</span>
            <h3>Serveurs Minecraft</h3>
            <p>L'état des serveurs en direct, leur adresse à copier et le modpack à installer pour chacun.</p>
            <span class="tag">En direct</span>
        </a>
        <a href="/mods-guide.html" class="hub-card c-cyan">
            <span class="icon">📦</span>
            <h3>Guide des mods</h3>
            <p>Les mods du pack DiscoverMC, ce qu'ils apportent et comment s'en servir.</p>
            <span class="tag">Guide</span>
        </a>
        <a href="/PUZZLES-MEATBALLCRAFT-FR.html" class="hub-card c-purple">
            <span class="icon">🧩</span>
            <h3>Puzzles MeatballCraft</h3>
            <p>Les solutions des puzzles cachés du modpack MeatballCraft.</p>
            <span class="tag">Guide</span>
        </a>
        <a href="{{ path('app_bees') }}" class="hub-card c-yellow">
            <span class="icon">🐝</span>
            <h3>Bee Tracker</h3>
            <p>Suis ton élevage d'abeilles : celles obtenues, celles qui manquent et ce que tu peux débloquer maintenant.</p>
            <span class="tag">Outil</span>
        </a>
    </div>
</section>

<section class="hub-section" id="retro" style="--section-color: var(--purple)">
    <div class="section-head">
        <h2>🕹️ Rétro-gaming</h2>
        <p>Les jeux des anciennes consoles, jouables dans le navigateur</p>
    </div>
    <div class="card-grid">
        <a href="https://romm.multimod.ovh" target="_blank" rel="noopener" class="hub-card c-purple featured">
            <span class="icon">👾</span>
            <h3>RomM ↗</h3>
            <p>La bibliothèque de jeux rétro : parcours les consoles et lance un jeu en un clic, sans rien installer.</p>
            <span class="tag">Site externe</span>
        </a>
        <a href="{{ path('app_guide_romm') }}" class="hub-card c-cyan">
            <span class="icon">📖</span>
            <h3>Guide RomM</h3>
            <p>Se connecter, trouver un jeu, y jouer et sauvegarder sa partie : tout expliqué pas à pas.</p>
            <span class="tag">Guide</span>
        </a>
    </div>
</section>

<section class="hub-section" id="discord" style="--section-color: var(--blurple)">
    <div class="section-head">
        <h2>💬 Discord</h2>
        <p>Les bots du serveur, expliqués simplement</p>
    </div>
    <div class="card-grid">
        <a href="{{ path('app_guide_bot_jeux') }}" class="hub-card c-blurple">
            <span class="icon">🎲</span>
            <h3>Bot de mini-jeux</h3>
            <p>Blind tests LoL, Pokémon, musiques de jeux, génériques et Pokédle du jour : comment lancer une partie et jouer.</p>
            <span class="tag">Guide</span>
        </a>
        <a href="{{ path('app_guide_bot_musique') }}" class="hub-card c-pink">
            <span class="icon">🎧</span>
            <h3>Bot musique</h3>
            <p>Écouter de la musique ensemble en vocal : lancer un titre, gérer la file, pause et volume.</p>
            <span class="tag">Guide</span>
        </a>
    </div>
</section>
{% endblock %}
