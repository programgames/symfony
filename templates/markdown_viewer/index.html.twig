<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>{{ title }}</title>
    <style>
        :root {
            --bg: #0f1117;
            --bg-soft: #161923;
            --panel: #1a1d27;
            --panel-2: #20232f;
            --border: #2a2d3e;
            --text: #e2e4f0;
            --text-strong: #ffffff;
            --muted: #8b90ad;
            --accent: #60a5fa;
            --accent-soft: rgba(96, 165, 250, .14);
            --code-bg: #12151d;
            --shadow: 0 10px 30px rgba(0, 0, 0, .35);
        }

        html[data-theme="light"] {
            --bg: #f7f8fb;
            --bg-soft: #ffffff;
            --panel: #ffffff;
            --panel-2: #f1f3f8;
            --border: #dfe3ec;
            --text: #2b3040;
            --text-strong: #11131a;
            --muted: #6b7186;
            --accent: #2563eb;
            --accent-soft: rgba(37, 99, 235, .10);
            --code-bg: #f1f3f8;
            --shadow: 0 10px 30px rgba(15, 23, 42, .08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html { scroll-behavior: smooth; }

        body {
            font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        /* ---------- Barre de progression ---------- */
        #progress {
            position: fixed; top: 0; left: 0; height: 3px; width: 0;
            background: linear-gradient(90deg, var(--accent), #a78bfa);
            z-index: 60; transition: width .1s linear;
        }

        /* ---------- En-tête ---------- */
        header.topbar {
            position: sticky; top: 0; z-index: 50;
            display: flex; align-items: center; gap: 1rem;
            padding: .75rem 1.25rem;
            background: color-mix(in srgb, var(--bg) 88%, transparent);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
        }

        header.topbar h1 {
            font-size: 1rem; font-weight: 600; color: var(--text-strong);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .spacer { flex: 1; }

        .icon-btn {
            display: inline-flex; align-items: center; justify-content: center;
            gap: .4rem;
            height: 34px; min-width: 34px; padding: 0 .6rem;
            border: 1px solid var(--border); border-radius: 8px;
            background: var(--panel); color: var(--text);
            font-size: .85rem; cursor: pointer;
            transition: background .15s, border-color .15s;
        }
        .icon-btn:hover { background: var(--panel-2); border-color: var(--accent); }

        #menu-toggle { display: none; }

        /* ---------- Mise en page ---------- */
        .layout {
            display: grid;
            grid-template-columns: 310px minmax(0, 1fr);
            align-items: start;
            max-width: 1500px; margin: 0 auto;
        }

        /* ---------- Sommaire ---------- */
        aside.toc {
            position: sticky; top: 55px;
            height: calc(100vh - 55px);
            display: flex; flex-direction: column;
            border-right: 1px solid var(--border);
            background: var(--bg-soft);
        }

        .toc-head { padding: 1rem 1rem .6rem; }

        .toc-head label {
            display: block; font-size: .7rem; letter-spacing: .08em;
            text-transform: uppercase; color: var(--muted); margin-bottom: .5rem;
        }

        #toc-search {
            width: 100%; padding: .5rem .7rem;
            border: 1px solid var(--border); border-radius: 8px;
            background: var(--panel); color: var(--text); font-size: .85rem;
        }
        #toc-search:focus { outline: none; border-color: var(--accent); }

        nav#toc { overflow-y: auto; padding: 0 .6rem 2rem; flex: 1; }

        nav#toc a {
            display: block; padding: .3rem .6rem; margin: 1px 0;
            border-radius: 6px; border-left: 2px solid transparent;
            color: var(--muted); text-decoration: none; font-size: .84rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        nav#toc a:hover { background: var(--panel-2); color: var(--text); }
        nav#toc a.active {
            background: var(--accent-soft); color: var(--accent);
            border-left-color: var(--accent); font-weight: 600;
        }
        nav#toc a.lvl-1 {
            margin-top: 1rem; font-size: .74rem; font-weight: 700;
            letter-spacing: .07em; text-transform: uppercase; color: var(--text-strong);
        }
        nav#toc a.lvl-2 { padding-left: .9rem; }
        nav#toc a.lvl-3 { padding-left: 1.8rem; font-size: .8rem; }
        nav#toc a.hidden { display: none; }

        .toc-empty { padding: 1rem .6rem; color: var(--muted); font-size: .82rem; }

        /* ---------- Contenu ---------- */
        main {
            padding: 2.5rem clamp(1rem, 4vw, 3.5rem) 6rem;
            max-width: 950px;
            min-width: 0;
        }

        .md h1, .md h2, .md h3, .md h4 {
            color: var(--text-strong); line-height: 1.3;
            scroll-margin-top: 70px; position: relative;
        }

        .md h1 {
            font-size: 2rem; margin: 3.5rem 0 1.2rem;
            padding-bottom: .6rem; border-bottom: 2px solid var(--accent);
        }
        .md > h1:first-child { margin-top: 0; }

        .md h2 {
            font-size: 1.45rem; margin: 2.6rem 0 1rem;
            padding-bottom: .4rem; border-bottom: 1px solid var(--border);
        }
        .md h3 { font-size: 1.13rem; margin: 2rem 0 .7rem; color: var(--accent); }
        .md h4 { font-size: 1rem; margin: 1.4rem 0 .5rem; }

        .anchor {
            position: absolute; left: -1.1em; width: 1em;
            color: var(--muted); text-decoration: none;
            opacity: 0; transition: opacity .15s;
        }
        .md h1:hover .anchor, .md h2:hover .anchor,
        .md h3:hover .anchor, .md h4:hover .anchor { opacity: 1; }

        .md p, .md ul, .md ol { margin: .9rem 0; }
        .md li { margin: .35rem 0; }
        .md ul, .md ol { padding-left: 1.4rem; }

        .md a { color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; }
        .md a:hover { border-bottom-color: var(--accent); }

        .md strong { color: var(--text-strong); }

        .md blockquote {
            margin: 1.2rem 0; padding: .8rem 1.1rem;
            border-left: 3px solid var(--accent);
            background: var(--panel); border-radius: 0 8px 8px 0;
            color: var(--text);
        }
        .md blockquote p { margin: .3rem 0; }

        .md code {
            font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
            font-size: .87em; padding: .13em .38em;
            background: var(--code-bg); border: 1px solid var(--border);
            border-radius: 5px;
        }

        .md pre {
            margin: 1.2rem 0; padding: 1rem 1.1rem;
            background: var(--code-bg); border: 1px solid var(--border);
            border-radius: 10px; overflow-x: auto;
        }
        .md pre code { padding: 0; border: 0; background: none; font-size: .85em; }

        .table-wrap { overflow-x: auto; margin: 1.3rem 0; border-radius: 10px; border: 1px solid var(--border); }
        .md table { width: 100%; border-collapse: collapse; font-size: .88rem; }
        .md th, .md td { padding: .55rem .8rem; text-align: left; border-bottom: 1px solid var(--border); }
        .md th { background: var(--panel-2); color: var(--text-strong); font-weight: 600; white-space: nowrap; }
        .md tbody tr:last-child td { border-bottom: 0; }
        .md tbody tr:hover { background: var(--panel); }

        .md hr { margin: 3rem 0; border: 0; border-top: 1px solid var(--border); }

        .md img { max-width: 100%; height: auto; border-radius: 8px; }

        /* ---------- Retour en haut ---------- */
        #to-top {
            position: fixed; right: 1.5rem; bottom: 1.5rem; z-index: 40;
            width: 42px; height: 42px; border-radius: 50%;
            border: 1px solid var(--border); background: var(--panel);
            color: var(--text); cursor: pointer; box-shadow: var(--shadow);
            opacity: 0; pointer-events: none; transition: opacity .2s;
        }
        #to-top.show { opacity: 1; pointer-events: auto; }

        /* ---------- Mobile ---------- */
        @media (max-width: 900px) {
            .layout { grid-template-columns: minmax(0, 1fr); }
            #menu-toggle { display: inline-flex; }
            aside.toc {
                position: fixed; top: 0; left: 0; z-index: 55;
                width: 300px; height: 100vh;
                transform: translateX(-100%); transition: transform .22s ease;
                box-shadow: var(--shadow);
            }
            aside.toc.open { transform: translateX(0); }
            .overlay {
                position: fixed; inset: 0; z-index: 54;
                background: rgba(0, 0, 0, .5);
                opacity: 0; pointer-events: none; transition: opacity .22s;
            }
            .overlay.show { opacity: 1; pointer-events: auto; }
            main { padding: 1.5rem 1.1rem 4rem; }
            .md h1 { font-size: 1.6rem; }
            .md h2 { font-size: 1.25rem; }
        }

        @media print {
            header.topbar, aside.toc, #to-top, #progress, .overlay, .anchor { display: none !important; }
            .layout { display: block; }
            main { max-width: none; padding: 0; }
            body { background: #fff; color: #000; }
        }
    </style>
</head>
<body>
<div id="progress"></div>

<header class="topbar">
    <button class="icon-btn" id="menu-toggle" aria-label="Sommaire">☰</button>
    <h1>{{ title }}</h1>
    <span class="spacer"></span>
    <button class="icon-btn" id="theme-toggle" title="Changer de thème">🌙</button>
    <button class="icon-btn" id="print-btn" title="Imprimer / PDF">🖨️</button>
</header>

<div class="overlay" id="overlay"></div>

<div class="layout">
    <aside class="toc" id="sidebar">
        <div class="toc-head">
            <label for="toc-search">Sommaire</label>
            <input type="search" id="toc-search" placeholder="Filtrer les chapitres…" autocomplete="off">
        </div>
        <nav id="toc"></nav>
    </aside>

    <main>
        <article class="md" id="content"></article>
    </main>
</div>

<button id="to-top" title="Haut de page">↑</button>

<textarea id="md-source" hidden>
{{ markdown }}</textarea>

<script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
<script>
(function () {
    const source = document.getElementById('md-source').value;
    const content = document.getElementById('content');

    marked.setOptions({ gfm: true, breaks: false });
    content.innerHTML = marked.parse(source);

    /* --- Tables scrollables --- */
    content.querySelectorAll('table').forEach(function (table) {
        const wrap = document.createElement('div');
        wrap.className = 'table-wrap';
        table.parentNode.insertBefore(wrap, table);
        wrap.appendChild(table);
    });

    /* --- Sommaire --- */
    const slugs = {};
    function slugify(text) {
        let base = text.toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-z0-9\s-]/g, '')
            .trim().replace(/\s+/g, '-');
        if (!base) base = 'section';
        slugs[base] = (slugs[base] || 0) + 1;
        return slugs[base] > 1 ? base + '-' + slugs[base] : base;
    }

    const toc = document.getElementById('toc');
    const headings = content.querySelectorAll('h1, h2, h3');
    const links = [];

    headings.forEach(function (h) {
        h.id = h.id || slugify(h.textContent);

        const anchor = document.createElement('a');
        anchor.className = 'anchor';
        anchor.href = '#' + h.id;
        anchor.textContent = '#';
        anchor.setAttribute('aria-hidden', 'true');
        h.prepend(anchor);

        const link = document.createElement('a');
        link.href = '#' + h.id;
        link.className = 'lvl-' + h.tagName.charAt(1);
        link.textContent = h.textContent.replace(/^#/, '');
        link.dataset.target = h.id;
        toc.appendChild(link);
        links.push(link);
    });

    const empty = document.createElement('p');
    empty.className = 'toc-empty';
    empty.textContent = 'Aucun chapitre ne correspond.';
    empty.hidden = true;
    toc.appendChild(empty);

    /* --- Filtre du sommaire --- */
    document.getElementById('toc-search').addEventListener('input', function (e) {
        const q = e.target.value.toLowerCase().trim();
        let visible = 0;
        links.forEach(function (link) {
            const match = !q || link.textContent.toLowerCase().includes(q);
            link.classList.toggle('hidden', !match);
            if (match) visible++;
        });
        empty.hidden = visible > 0;
    });

    /* --- Chapitre actif --- */
    const byId = {};
    links.forEach(function (l) { byId[l.dataset.target] = l; });
    let current = null;

    function setActive(id) {
        if (!id || id === current) return;
        if (current && byId[current]) byId[current].classList.remove('active');
        current = id;
        const link = byId[id];
        if (!link) return;
        link.classList.add('active');
        const box = toc.getBoundingClientRect();
        const pos = link.getBoundingClientRect();
        if (pos.top < box.top || pos.bottom > box.bottom) {
            link.scrollIntoView({ block: 'nearest' });
        }
    }

    const observer = new IntersectionObserver(function (entries) {
        const visible = entries.filter(function (e) { return e.isIntersecting; });
        if (visible.length) {
            visible.sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
            setActive(visible[0].target.id);
        }
    }, { rootMargin: '-60px 0px -75% 0px', threshold: 0 });

    headings.forEach(function (h) { observer.observe(h); });

    /* --- Progression + retour en haut --- */
    const progress = document.getElementById('progress');
    const toTop = document.getElementById('to-top');

    function onScroll() {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
        toTop.classList.toggle('show', window.scrollY > 600);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    toTop.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    /* --- Sommaire mobile --- */
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');

    function closeMenu() {
        sidebar.classList.remove('open');
        overlay.classList.remove('show');
    }
    document.getElementById('menu-toggle').addEventListener('click', function () {
        sidebar.classList.toggle('open');
        overlay.classList.toggle('show');
    });
    overlay.addEventListener('click', closeMenu);
    toc.addEventListener('click', function (e) {
        if (e.target.tagName === 'A') closeMenu();
    });

    /* --- Thème --- */
    const themeBtn = document.getElementById('theme-toggle');
    function applyTheme(theme) {
        document.documentElement.dataset.theme = theme;
        themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
        try { localStorage.setItem('md-viewer-theme', theme); } catch (err) { /* stockage indisponible */ }
    }
    let saved = 'dark';
    try { saved = localStorage.getItem('md-viewer-theme') || 'dark'; } catch (err) { /* stockage indisponible */ }
    applyTheme(saved);
    themeBtn.addEventListener('click', function () {
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
    });

    document.getElementById('print-btn').addEventListener('click', function () { window.print(); });

    /* --- Ancre présente dans l'URL au chargement --- */
    if (location.hash) {
        const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (target) target.scrollIntoView();
    }
})();
</script>
</body>
</html>
