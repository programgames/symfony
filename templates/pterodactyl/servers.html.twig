{% extends 'base.html.twig' %}

{% block title %}Serveurs Minecraft{% endblock %}

{% block stylesheets %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&display=swap');

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        min-height: 100vh;
        background: linear-gradient(180deg, #87CEEB 0%, #87CEEB 85%, #4a8c2a 85%, #4a8c2a 87%, #8B4513 87%);
        font-family: 'VT323', monospace;
        overflow-x: hidden;
    }

    /* Page sur un seul écran : en-tête compact + grille qui prend le reste */
    .main-container {
        min-height: 100vh;
        max-width: 1600px;
        margin: 0 auto;
        padding: 1rem 1rem 4.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .header {
        display: flex;
        align-items: baseline;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.4rem 1.2rem;
    }

    .title {
        font-family: 'Press Start 2P', cursive;
        font-size: 1.4rem;
        color: #fff;
        text-shadow:
            3px 3px 0 #3a3a3a,
            -2px -2px 0 #000,
            2px -2px 0 #000,
            -2px 2px 0 #000,
            2px 2px 0 #000;
    }

    .subtitle {
        font-size: 1.3rem;
        color: #fff;
        text-shadow: 2px 2px 0 #3a3a3a;
    }

    .servers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 0.75rem;
        align-content: start;
    }

    /* Tuile serveur - style inventaire Minecraft */
    .server-card {
        background: #c6c6c6;
        border: 3px solid #000;
        box-shadow:
            inset 3px 3px 0 #fff,
            inset -3px -3px 0 #555,
            5px 5px 0 rgba(0, 0, 0, 0.3);
        padding: 0.6rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        min-width: 0;
    }

    .server-card.is-offline {
        opacity: 0.75;
    }

    .server-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .status-dot {
        flex: none;
        width: 12px;
        height: 12px;
        border: 2px solid #000;
    }

    .status-dot.online {
        background: #4CAF50;
        box-shadow: 0 0 6px #4CAF50;
    }

    .status-dot.offline {
        background: #f44336;
    }

    .server-name {
        font-family: 'Press Start 2P', cursive;
        font-size: 0.65rem;
        line-height: 1.4;
        color: #000;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .status-label {
        margin-left: auto;
        flex: none;
        font-size: 1rem;
        color: #333;
    }

    .server-address {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: #8b8b8b;
        border: 2px solid #000;
        box-shadow:
            inset 2px 2px 0 #aaa,
            inset -2px -2px 0 #666;
        padding: 0.2rem 0.2rem 0.2rem 0.5rem;
    }

    .server-address code {
        flex: 1;
        min-width: 0;
        font-family: 'VT323', monospace;
        font-size: 1.25rem;
        color: #fff;
        text-shadow: 1px 1px 0 #000;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .copy-btn {
        flex: none;
        background: #4CAF50;
        border: 2px solid #000;
        color: #fff;
        padding: 0.1rem 0.5rem;
        font-family: 'VT323', monospace;
        font-size: 1rem;
        cursor: pointer;
        box-shadow:
            inset 1px 1px 0 #6bd66f,
            inset -1px -1px 0 #2e7d32;
    }

    .copy-btn:hover {
        background: #66BB6A;
    }

    .copy-btn:active {
        transform: translateY(1px);
        box-shadow: none;
    }

    .copy-btn.copied {
        background: #2196F3;
    }

    .server-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        font-size: 1.1rem;
        color: #333;
    }

    .curseforge-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: #f16436;
        color: #fff;
        padding: 0 0.4rem;
        font-size: 1rem;
        border: 2px solid #000;
        text-decoration: none;
    }

    .curseforge-badge:hover {
        background: #ff7849;
        color: #fff;
    }

    .curseforge-badge svg {
        width: 12px;
        height: 12px;
        fill: currentColor;
    }

    /* Icône du serveur (favicon renvoyé par le ping, sinon bloc d'herbe) */
    .server-icon {
        flex: none;
        width: 32px;
        height: 32px;
        border: 2px solid #000;
        image-rendering: pixelated;
        background: linear-gradient(180deg, #5d9b38 0 30%, #8b5a2b 30%);
    }

    .server-motd {
        font-size: 1.05rem;
        line-height: 1.1;
        color: #444;
        font-style: italic;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .chips:empty {
        display: none;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        background: #6b6b6b;
        color: #fff;
        text-shadow: 1px 1px 0 #000;
        border: 2px solid #000;
        padding: 0 0.4rem;
        font-size: 1.05rem;
        line-height: 1.3;
    }

    .chip.version { background: #3f76e4; }
    .chip.loader { background: #a0522d; }
    .chip.players { background: #4CAF50; }
    .chip.players.empty { background: #6b6b6b; }
    .chip.game { background: #7b52ab; }

    .player-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.2rem 0.6rem;
        font-size: 1.05rem;
        color: #222;
    }

    .player-list span {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .player-list img {
        width: 16px;
        height: 16px;
        image-rendering: pixelated;
    }

    /* Infos techniques : petite grille clé / valeur */
    .tech {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.15rem 0.75rem;
        background: #b0b0b0;
        border: 2px solid #000;
        box-shadow:
            inset 2px 2px 0 #d8d8d8,
            inset -2px -2px 0 #7a7a7a;
        padding: 0.3rem 0.5rem;
        font-size: 1.05rem;
        color: #222;
    }

    .tech div {
        display: flex;
        justify-content: space-between;
        gap: 0.4rem;
        min-width: 0;
    }

    .tech dt {
        color: #555;
    }

    .tech dd {
        text-align: right;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Jauge RAM façon barre d'expérience */
    .tech .xp-bar {
        grid-column: 1 / -1;
        display: block;
        height: 6px;
        background: #2a2a2a;
        border: 1px solid #000;
    }

    .xp-bar span {
        display: block;
        height: 100%;
        background: #80ff20;
    }

    .xp-bar.high span {
        background: #ff9d20;
    }

    .server-meta .egg {
        font-size: 1rem;
        color: #555;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 3rem 1rem;
        background: #c6c6c6;
        border: 3px solid #000;
        box-shadow:
            inset 3px 3px 0 #fff,
            inset -3px -3px 0 #555;
        font-family: 'Press Start 2P', cursive;
        font-size: 0.8rem;
        color: #555;
    }

    @media (max-width: 600px) {
        .title {
            font-size: 1rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="main-container">
    <header class="header">
        <h1 class="title">Serveurs Minecraft</h1>
        <p class="subtitle">Rejoins l'aventure !</p>
    </header>

    <div class="servers-grid">
        {% for server in data %}
        {% set online = server.state != 'offline' %}
        {% set mc = server.minecraft %}
        <div class="server-card{{ online ? '' : ' is-offline' }}">
            <div class="server-head">
                {% if mc and mc.favicon %}
                    <img class="server-icon" src="{{ mc.favicon }}" alt="">
                {% elseif server.game == 'Minecraft' %}
                    <span class="server-icon"></span>
                {% endif %}
                <span class="status-dot {{ online ? 'online' : 'offline' }}"></span>
                <span class="server-name" title="{{ server.name }}">{{ server.name }}</span>
                <span class="status-label">
                    {%- if server.state == 'starting' %}Démarrage…{% elseif server.state == 'stopping' %}Arrêt…{% elseif online %}En ligne{% else %}Hors ligne{% endif -%}
                </span>
            </div>

            {% if mc and mc.motd and mc.motd != 'A Minecraft Server' and mc.motd != server.name %}
            <p class="server-motd">{{ mc.motd }}</p>
            {% endif %}
            {% if server.description %}
            <p class="server-motd">{{ server.description }}</p>
            {% endif %}

            {% if server.url %}
            <div class="server-address">
                <code>{{ server.url }}</code>
                <button class="copy-btn" onclick="copyToClipboard('{{ server.url }}', this)">Copier</button>
            </div>
            {% endif %}

            <div class="chips">
                {%- if mc %}
                    {% if mc.version %}<span class="chip version" title="Version de Minecraft (protocole {{ mc.protocol }})">{{ mc.version }}</span>{% endif %}
                    <span class="chip loader">{{ mc.modLoader ?? 'Vanilla' }}{% if mc.modCount %} · {{ mc.modCount }} mods{% endif %}</span>
                    <span class="chip players{{ mc.playersOnline == 0 ? ' empty' : '' }}" title="Joueurs connectés">{{ mc.playersOnline }} / {{ mc.playersMax }} joueurs</span>
                {% elseif server.game != 'Minecraft' %}
                    {% if server.game %}<span class="chip game">{{ server.game }}</span>{% endif %}
                {% elseif server.state == 'running' %}
                    <span class="chip">Le serveur charge encore…</span>
                {% endif -%}
            </div>

            {% if mc and mc.players is not empty %}
            <div class="player-list">
                {% for player in mc.players %}
                    <span><img src="https://mc-heads.net/avatar/{{ player|url_encode }}/16" alt="" loading="lazy">{{ player }}</span>
                {% endfor %}
                {% if mc.playersOnline > mc.players|length %}<span>+{{ mc.playersOnline - mc.players|length }}</span>{% endif %}
            </div>
            {% endif %}

            <dl class="tech">
                <div>
                    <dt>RAM</dt>
                    <dd>
                        {%- if server.memoryUsed is not null %}{{ (server.memoryUsed / 1024)|round(1) }}{% if server.memoryLimit > 0 %} / {{ (server.memoryLimit / 1024)|round(1) }}{% endif %} Go
                        {%- elseif server.memoryLimit > 0 %}{{ (server.memoryLimit / 1024)|round(1) }} Go
                        {%- else %}illimitée{% endif -%}
                    </dd>
                </div>
                <div>
                    <dt>CPU</dt>
                    <dd>
                        {%- if server.cpuUsed is not null %}{{ server.cpuUsed|round }} %{% if server.cpuLimit > 0 %} / {{ server.cpuLimit }} %{% endif %}
                        {%- elseif server.cpuLimit > 0 %}max {{ server.cpuLimit }} %
                        {%- else %}—{% endif -%}
                    </dd>
                </div>
                {% if server.memoryUsed is not null and server.memoryLimit > 0 %}
                    {% set ramPct = min(100, server.memoryUsed / server.memoryLimit * 100) %}
                    <span class="xp-bar{{ ramPct > 85 ? ' high' : '' }}" title="RAM utilisée : {{ ramPct|round }} %"><span style="width: {{ ramPct|round(1) }}%"></span></span>
                {% endif %}
                <div>
                    <dt>Disque</dt>
                    <dd>
                        {%- if server.diskUsed is not null %}{{ (server.diskUsed / 1024)|round(1) }}{% if server.diskLimit > 0 %} / {{ (server.diskLimit / 1024)|round }}{% endif %} Go
                        {%- elseif server.diskLimit > 0 %}{{ (server.diskLimit / 1024)|round }} Go
                        {%- else %}—{% endif -%}
                    </dd>
                </div>
                <div>
                    <dt>Uptime</dt>
                    <dd>{{ server.uptime ?? '—' }}</dd>
                </div>
                {% if server.java %}
                <div>
                    <dt>Java</dt>
                    <dd>{{ server.java }}</dd>
                </div>
                {% endif %}
                {% if mc %}
                <div>
                    <dt>Latence</dt>
                    <dd>{{ mc.latency }} ms</dd>
                </div>
                {% endif %}
            </dl>

            <div class="server-meta">
                <span class="egg" title="Type de serveur Pterodactyl (egg)">{{ server.egg != server.game ? server.egg }}</span>
                {% if server.modpack and server.modpack.url %}
                <a href="{{ server.modpack.url }}" target="_blank" rel="noopener noreferrer" class="curseforge-badge" title="Voir le modpack sur CurseForge">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18.326 9.218L19.378 12H24L18.074 14.41L19.854 24H13.062L12 20.428L10.938 24H4.146L5.926 14.41L0 12H4.622L5.674 9.218H8.058L6.584 12.892L5.504 18.648H8.196L9.036 15.14H12.964L13.804 18.648H16.496L15.416 12.892L13.942 9.218H18.326ZM12 2.056L14.388 0L15.156 3.016L12 4.11L8.844 3.016L9.612 0L12 2.056Z"/>
                    </svg>
                    {% if server.modpack.isDirectLink %}Modpack{% else %}CurseForge{% endif %}
                </a>
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="empty-state">Aucun serveur disponible</div>
        {% endfor %}
    </div>
</div>

<script>
function copyToClipboard(text, button) {
    navigator.clipboard.writeText(text).then(function() {
        const originalText = button.textContent;
        button.textContent = 'Copié !';
        button.classList.add('copied');
        setTimeout(function() {
            button.textContent = originalText;
            button.classList.remove('copied');
        }, 2000);
    });
}
</script>
{% endblock %}
