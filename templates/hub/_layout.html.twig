{% extends 'base.html.twig' %}

{#
    Gabarit commun de l'accueil et des guides : thème néon, barre de navigation, pied de page.
    Les pages définissent `hub_title`, `hub_content` et, si besoin, `hub_styles` / `hub_scripts`.
    `active_nav` (home, jeux, minecraft, retro, discord) met en avant l'entrée du menu.
#}

{% block title %}{% block hub_title %}GameHub{% endblock %} · GameHub{% endblock %}

{% block stylesheets %}
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
    :root {
        --bg: #0a0a1a;
        --bg-2: #16213e;
        --surface: rgba(255, 255, 255, 0.04);
        --surface-hover: rgba(255, 255, 255, 0.08);
        --border: rgba(255, 255, 255, 0.10);
        --text: #f1f5f9;
        --muted: rgba(241, 245, 249, 0.68);
        --faint: rgba(241, 245, 249, 0.40);
        --cyan: #22e5ff;
        --cyan-glow: rgba(34, 229, 255, 0.35);
        --yellow: #ffcc00;
        --green: #44ff88;
        --purple: #b388ff;
        --blurple: #7289ff;
        --pink: #ff5fa2;
        --orange: #ff9f43;
        --radius: 18px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
        min-height: 100vh;
        background: linear-gradient(135deg, var(--bg) 0%, #1a1a2e 50%, var(--bg-2) 100%) fixed;
        color: var(--text);
        font-family: 'Rajdhani', system-ui, sans-serif;
        font-size: 1.1rem;
        line-height: 1.6;
        overflow-x: hidden;
    }

    a { color: var(--cyan); }

    .bg-grid {
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 50px 50px;
        pointer-events: none;
        z-index: 0;
    }

    .particles { position: fixed; inset: 0; pointer-events: none; z-index: 1; overflow: hidden; }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(0, 255, 255, 0.6);
        border-radius: 50%;
        animation: float 15s infinite;
        box-shadow: 0 0 10px rgba(0, 255, 255, 0.8);
    }

    @keyframes float {
        0%, 100% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
        10%, 90% { opacity: 1; }
        100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .particles { display: none; }
        html { scroll-behavior: auto; }
    }

    /* Barre de navigation */
    .topnav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(10, 10, 26, 0.82);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
    }

    .topnav-inner {
        max-width: 1150px;
        margin: 0 auto;
        padding: 0.7rem 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .brand {
        font-family: 'Orbitron', sans-serif;
        font-weight: 900;
        font-size: 1.15rem;
        letter-spacing: 0.18em;
        color: #fff;
        text-decoration: none;
        text-shadow: 0 0 12px var(--cyan-glow);
        white-space: nowrap;
    }

    .nav-links {
        display: flex;
        gap: 0.25rem;
        margin-left: auto;
        overflow-x: auto;
        scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar { display: none; }

    .nav-links a {
        color: var(--muted);
        text-decoration: none;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        white-space: nowrap;
        transition: color 0.2s, background 0.2s;
    }

    .nav-links a:hover { color: #fff; background: var(--surface-hover); }
    .nav-links a.active { color: var(--bg); background: var(--cyan); }

    .page {
        position: relative;
        z-index: 10;
        max-width: 1150px;
        margin: 0 auto;
        padding: 2.5rem 1rem 3rem;
    }

    .footer {
        position: relative;
        z-index: 10;
        text-align: center;
        color: var(--faint);
        font-size: 0.95rem;
        padding: 2rem 1rem 2.5rem;
        border-top: 1px solid var(--border);
    }

    .footer a { color: var(--muted); }

    /* Éléments communs aux guides */
    .page-hero { text-align: center; margin-bottom: 2.5rem; }

    .page-hero .eyebrow {
        display: inline-block;
        font-weight: 700;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        font-size: 0.85rem;
        color: var(--accent, var(--cyan));
        margin-bottom: 0.5rem;
    }

    .page-hero h1 {
        font-family: 'Orbitron', sans-serif;
        font-size: clamp(1.8rem, 5vw, 2.8rem);
        line-height: 1.2;
        text-shadow: 0 0 24px var(--accent-glow, var(--cyan-glow));
    }

    .page-hero p { color: var(--muted); max-width: 680px; margin: 0.8rem auto 0; font-size: 1.2rem; }

    .guide { max-width: 860px; margin: 0 auto; }

    .toc {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 2.5rem;
    }

    .toc a {
        color: var(--text);
        text-decoration: none;
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 0.3rem 0.9rem;
        border-radius: 999px;
        font-weight: 600;
        transition: border-color 0.2s, background 0.2s;
    }

    .toc a:hover { border-color: var(--accent, var(--cyan)); background: var(--surface-hover); }

    .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.6rem 1.8rem;
        margin-bottom: 1.5rem;
        backdrop-filter: blur(10px);
        scroll-margin-top: 5rem;
    }

    .panel h2 {
        font-family: 'Orbitron', sans-serif;
        font-size: 1.3rem;
        color: var(--accent, var(--cyan));
        margin-bottom: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .panel h3 { font-size: 1.2rem; margin: 1.2rem 0 0.4rem; }
    .panel p + p { margin-top: 0.7rem; }
    .panel ul, .panel ol { padding-left: 1.3rem; margin: 0.5rem 0; }
    .panel li { margin: 0.3rem 0; }
    .panel strong { color: #fff; }

    .num {
        flex: none;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: var(--bg);
        background: var(--accent, var(--cyan));
    }

    code, .chip {
        font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
        font-size: 0.92em;
        background: rgba(0, 0, 0, 0.35);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.05rem 0.4rem;
        color: #fff;
        white-space: nowrap;
    }

    kbd {
        font-family: ui-monospace, Consolas, monospace;
        font-size: 0.85em;
        background: #1f2937;
        border: 1px solid #4b5563;
        border-bottom-width: 3px;
        border-radius: 6px;
        padding: 0 0.4rem;
    }

    .ui {
        font-weight: 700;
        color: #fff;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        padding: 0 0.35rem;
        white-space: nowrap;
    }

    .callout {
        border-left: 4px solid var(--cyan);
        background: rgba(34, 229, 255, 0.07);
        border-radius: 10px;
        padding: 0.8rem 1rem;
        margin: 1rem 0;
    }

    .callout.tip { border-color: var(--green); background: rgba(68, 255, 136, 0.07); }
    .callout.warn { border-color: var(--orange); background: rgba(255, 159, 67, 0.08); }

    .table-wrap { overflow-x: auto; margin: 0.8rem 0; }

    table.cmds { width: 100%; border-collapse: collapse; }

    table.cmds th, table.cmds td {
        text-align: left;
        padding: 0.55rem 0.7rem;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
    }

    table.cmds th {
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--faint);
    }

    table.cmds td:first-child { white-space: nowrap; }

    details.faq {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 0.7rem 1rem;
        margin: 0.6rem 0;
        background: rgba(0, 0, 0, 0.15);
    }

    details.faq summary { cursor: pointer; font-weight: 700; color: #fff; }
    details.faq[open] summary { margin-bottom: 0.4rem; }

    .hub-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Orbitron', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        color: var(--bg);
        background: var(--accent, var(--cyan));
        border: 0;
        border-radius: 999px;
        padding: 0.7rem 1.4rem;
        cursor: pointer;
        box-shadow: 0 0 20px var(--accent-glow, var(--cyan-glow));
        transition: transform 0.2s;
    }

    .hub-btn:hover { transform: translateY(-2px); }

    .hub-btn.ghost {
        background: transparent;
        color: var(--text);
        border: 1px solid var(--border);
        box-shadow: none;
    }

    .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-top: 1.5rem; }

    @media (max-width: 640px) {
        body { font-size: 1.05rem; }
        .panel { padding: 1.2rem; }
        .brand { font-size: 1rem; letter-spacing: 0.1em; }
    }

    {% block hub_styles %}{% endblock %}
</style>
{% endblock %}

{% block body %}
{% set active_nav = active_nav|default('') %}
<div class="bg-grid"></div>
<div class="particles" aria-hidden="true">
    {% for i in 1..16 %}
    <div class="particle" style="left: {{ random(0, 100) }}%; animation-delay: {{ random(0, 15) }}s; animation-duration: {{ random(10, 20) }}s;"></div>
    {% endfor %}
</div>

<nav class="topnav">
    <div class="topnav-inner">
        <a class="brand" href="{{ path('app_home') }}">GAMEHUB</a>
        <div class="nav-links">
            <a href="{{ path('app_home') }}#jeux" class="{{ active_nav == 'jeux' ? 'active' }}">Jeux</a>
            <a href="{{ path('app_home') }}#minecraft" class="{{ active_nav == 'minecraft' ? 'active' }}">Minecraft</a>
            <a href="{{ path('app_home') }}#retro" class="{{ active_nav == 'retro' ? 'active' }}">Rétro</a>
            <a href="{{ path('app_home') }}#discord" class="{{ active_nav == 'discord' ? 'active' }}">Discord</a>
        </div>
    </div>
</nav>

<main class="page">
    {% block hub_content %}{% endblock %}
</main>

<footer class="footer">
    <p>GameHub · multimod.ovh — <a href="{{ path('app_home') }}">retour à l'accueil</a></p>
</footer>

{% block hub_scripts %}{% endblock %}
{% endblock %}

{# La barre de navigation suffit : pas de bouton flottant. #}
{% block home_link %}{% endblock %}
